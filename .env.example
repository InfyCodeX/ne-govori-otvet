# Шаблон локального .env; действующие ключи не публикуются.
BOT_MODE=demo
EXPECTED_BOT_USERNAME=ideya_fiks_106_bot
MAX_BOT_TOKEN=
MAX_POLL_TIMEOUT=30
MAX_POLL_LIMIT=100
MAX_WELCOME_LOGO=true
# Дополнительный доверенный сертификат MAX; TLS остаётся включённым.
MAX_CA_BUNDLE=
DATABASE_PATH=data/bot.sqlite3
LOG_LEVEL=INFO
AI_ENABLED=false
AI_OWNER_MANAGED=true
YANDEX_API_KEY=
YANDEX_MODEL_URI=
# Необязательный путь к внешнему файлу настроек.
# BOT_ENV_FILE=C:/Users/YourName/AppData/Local/NeGovoriOtvet/.env
# Форма настройки отключена по умолчанию.
ENABLE_AI_SETUP=false
